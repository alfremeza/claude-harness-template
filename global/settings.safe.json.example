{
  "_comment": "settings.safe.json — For teams, beginners, or anyone working with sensitive data (medical, financial, legal). Allowlist-based permissions. Adds a PreToolUse safety hook that blocks dangerous operations on sensitive files.",

  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(cat*)",
      "Bash(pwd)",
      "Bash(echo*)",
      "Bash(python3 -m pytest*)",
      "Bash(npm run test*)",
      "Bash(npm run type-check*)",
      "Bash(bash scripts/verify.sh)",
      "Bash(systemctl status*)",
      "Bash(systemctl is-active*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ],
    "deny": []
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd $HOME/.claude-brain && git pull --rebase 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Syncing memory..."
          }
        ]
      }
    ],

    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/protect-files.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/protect-paths.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/skills/continuous-learning-v2/hooks/observe.sh\" ] && $HOME/.claude/skills/continuous-learning-v2/hooks/observe.sh pre || true"
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$HOME/.claude/skills/continuous-learning-v2/hooks/observe.sh\" ] && $HOME/.claude/skills/continuous-learning-v2/hooks/observe.sh post || true"
          }
        ]
      }
    ],

    "PostCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "cd $HOME/.claude-brain && git add . && git diff --cached --quiet || git commit -m \"auto: /compact checkpoint $(date '+%Y-%m-%d %H:%M')\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Saving memories..."
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "cd $HOME/.claude-brain && git add . && git diff --cached --quiet || git commit -m \"auto: auto-compact checkpoint $(date '+%Y-%m-%d %H:%M')\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Saving memories (auto-compact)..."
          }
        ]
      }
    ],

    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd $HOME/.claude-brain && git add . && git diff --cached --quiet || git commit -m \"auto: session end $(date '+%Y-%m-%d %H:%M')\" 2>/dev/null || true && git push 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  }
}
